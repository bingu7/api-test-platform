# 复制为 .env 后按需修改（.env 已被 gitignore）
# 当前框架只读系统环境变量 / IDE Run Configuration / CI 环境变量注入，
# 不自动加载 .env 文件（未引入 python-dotenv）。
# 如需启用 .env 自动加载，自行 pip install python-dotenv 并在 conftest.py 顶部加：
#   from dotenv import load_dotenv; load_dotenv(PROJECT_ROOT / ".env")

TEST_ENV=dev
# 可选: dev | real | test | staging
#   dev     → Flask Mock（本地假数据，零外网）
#   real    → 本地 FastAPI 真实后端（电商：JWT+SQLite，全维度测试）
#   test    → jsonplaceholder.typicode.com（公开免费 API）
#   staging → 自定义 BASE_URL 覆盖

# 覆盖默认地址/账号（对接真实服务时改这里）
# BASE_URL=http://127.0.0.1:5000
# AUTH_URL=http://127.0.0.1:5000/api/login
# 注意：必须用 API_USERNAME / API_PASSWORD，不要用 USERNAME（Windows 系统变量）
# API_USERNAME=admin
# API_PASSWORD=admin123   # real 环境默认 seed 用户：admin / admin123

# CONNECT_TIMEOUT=5
# READ_TIMEOUT=15
# MOCK_HOST=127.0.0.1
# BACKEND_PORT=8000       # 前台手起后端时用（real 环境测试由 conftest 自动起）
